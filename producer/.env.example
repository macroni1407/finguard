# Confluent Cloud (Kafka) — copy to producer/.env and fill in. Never commit .env.
BOOTSTRAP_SERVERS=<bootstrap-server>:9092
API_KEY=<confluent-api-key>
API_SECRET=<confluent-api-secret>
TOPIC_NAME=credit_card_transactions

# Simulator
TRANSACTIONS_PER_SECOND=5
FRAUD_PERCENTAGE=0.08
# Keep these two values: sql/postgres/customers_historic.sql was generated from
# exactly this customer set (seed 42, 1000 customers). Changing them breaks the
# join between transactions and customers.
TOTAL_CUSTOMERS=1000
TOTAL_MERCHANTS=200
RANDOM_SEED=42
